{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/analyze",
      "dest": "server.js"
    },
    {
      "src": "/analyze-video",
      "dest": "server.js"
    },
    {
      "src": "/analytics",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
